{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pen1tent.github.io/tab-highway/schema/tabjson-v1.schema.json",
  "title": "tabjson v1 song",
  "description": "Guitar tab as timed events. See FORMAT.md. Bar-length coverage is checked by tools/validate.py, not by this schema.",
  "type": "object",
  "required": ["format", "version", "id", "meta", "tuning", "ppq", "bpm", "ts", "bars"],
  "properties": {
    "format": { "const": "tabjson" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "arranger": { "type": "string" },
        "source": {
          "type": "object",
          "properties": { "file": { "type": "string" }, "drive_id": { "type": "string" } }
        },
        "transcription": {
          "type": "object",
          "properties": {
            "by": { "type": "string" },
            "date": { "type": "string" },
            "status": { "enum": ["draft", "verified", "needs-review"] },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "tuning": { "type": "array", "items": { "type": "integer" }, "minItems": 6, "maxItems": 6 },
    "capo": { "type": "integer", "minimum": 0, "maximum": 12 },
    "ppq": { "const": 24 },
    "bpm": { "type": "number", "exclusiveMinimum": 0 },
    "ts": { "$ref": "#/$defs/ts" },
    "feel": { "enum": ["straight", "swing8", "swing16"] },
    "bars": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bar" } }
  },
  "$defs": {
    "ts": { "type": "array", "prefixItems": [{ "type": "integer", "minimum": 1 }, { "enum": [1, 2, 4, 8, 16] }], "minItems": 2, "maxItems": 2 },
    "bar": {
      "type": "object",
      "required": ["ev"],
      "properties": {
        "ev": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } },
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "ts": { "$ref": "#/$defs/ts" },
        "label": { "type": "string" },
        "src": { "type": "integer" }
      }
    },
    "event": {
      "type": "object",
      "required": ["t", "d"],
      "properties": {
        "t": { "type": "integer", "minimum": 0 },
        "d": { "type": "integer", "minimum": 1 },
        "rest": { "const": true },
        "n": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/note" } }
      },
      "oneOf": [{ "required": ["rest"] }, { "required": ["n"] }]
    },
    "note": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 6 },
        { "type": "integer", "minimum": 0, "maximum": 24 },
        { "enum": ["h", "s", "b", "x", "harm", "pm"] },
        { "type": "number" }
      ],
      "minItems": 2,
      "maxItems": 4
    }
  }
}
